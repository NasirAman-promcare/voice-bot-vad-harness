# AQIS lab, phase 0, CPU dependencies (direct needs only). The lock is phase0.txt.
#
# Regenerate the lock from the repository root with uv 0.8.17 after editing this file:
#   uv pip compile requirements/aqis_lab/phase0.in --universal --python-version 3.13 --generate-hashes --output-file requirements/aqis_lab/phase0.txt
# Pass the same command as --custom-compile-command so the lock header records it.
# --python-version is the major.minor from docs/environment/colab_probe.txt; --universal makes the
# pins valid on x86_64 and aarch64 Linux (cloud VM, Colab, Oracle). Install only with hash checking:
#   bash aqis_lab/deploy/dev_bootstrap.sh            (uv, development)
#   pip install --require-hashes -r requirements/aqis_lab/phase0.txt   (plain pip, e.g. Colab)

# Test runner for tests/aqis_lab (WP-0.0 FR-0.0-04).
pytest
# Contract validation (required by the WP-0.0 spec, used from WP-0.2).
jsonschema
# Parsing the CI workflow in tests (FR-0.0-10; owner-approved default 5e).
pyyaml
# Text normaliser and scorer (WP-0.3, owner approval docs/approvals/WP-0.3.md, questions 2 and 5).
# Exact pin: whisper-normalizer 0.1.1 is Whisper's English normaliser unchanged; 0.1.2 and later add rules.
whisper-normalizer==0.1.1
# Parquet score tables (FR-0.3-06).
pyarrow
# Independent cross-check of the alignment counts, used by tests only (FR-0.3-07).
jiwer==4.0.0
# Audio for the source registry and pack builder (WP-0.4, owner approval docs/approvals/WP-0.4.md, question 8):
# soundfile decodes LibriSpeech FLAC (checked against each file's STREAMINFO MD5); numpy holds the samples.
soundfile
numpy
# Results store queries (WP-0.6 FR-0.6-02: "a DuckDB view"; owner approval docs/approvals/WP-0.6.md).
# Its parquet and json extensions are statically linked, so no extension is downloaded at run time.
duckdb
