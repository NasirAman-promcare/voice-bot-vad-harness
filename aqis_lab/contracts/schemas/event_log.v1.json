{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aqis-lab:contracts:event_log:1.0",
  "title": "AQIS lab event-log record, version 1.0",
  "description": "One record of an event log (one line of a JSON Lines file). Contract document: docs/contracts/EVENT_LOG.md. Patterns end in $(?!\\n) so that they mean 'end of text' in both ECMA-262 and Python.",
  "type": "object",
  "required": ["schema_version", "run_id", "run_card_id", "seq", "component", "event_type", "clip_id",
               "audio_time_s", "wall_time_ns", "wall_clock_utc", "host_id", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"description": "Contract version, '<major>.<minor>'.", "enum": ["1.0"]},
    "run_id": {"description": "Identifier of one execution of a run card.", "type": "string", "pattern": "^\\S+$(?!\\n)"},
    "run_card_id": {"description": "run_card_id of the run card this run executes (SHA-256 hex).", "type": "string", "pattern": "^[0-9a-f]{64}$(?!\\n)"},
    "seq": {"description": "Per-run counter, 0 for the first event of a run, +1 for each next event.", "type": "integer", "minimum": 0},
    "component": {"description": "Part of the system that emitted the event.",
                  "enum": ["vad", "turn_end", "live_stt", "heavy_stt", "emotion", "filler", "analyzer", "fix", "runner"]},
    "event_type": {"description": "Kind of event; selects the payload sub-schema.",
                   "enum": ["run_started", "run_finished", "clip_started", "clip_finished", "speech_start", "speech_end",
                            "partial", "final", "timing_mark", "error"]},
    "clip_id": {"description": "Clip the event belongs to; null only for run-level events.", "type": ["string", "null"], "pattern": "^[a-z0-9-]+$(?!\\n)"},
    "audio_time_s": {"description": "Position in the clip's audio in seconds, or null with audio_time_reason.", "type": ["number", "null"], "minimum": 0},
    "audio_time_reason": {"description": "Why audio_time_s is null; present only when it is null.", "type": "string", "minLength": 1},
    "wall_time_ns": {"description": "Monotonic clock reading in nanoseconds.", "type": "integer", "minimum": 0},
    "wall_clock_utc": {"description": "Wall-clock time, UTC ISO 8601 with Z.", "$ref": "#/$defs/utc"},
    "host_id": {"description": "Machine that emitted the event.", "type": "string", "minLength": 1},
    "payload": {"description": "Event-type specific data; see the payload sub-schemas.", "type": "object"}
  },
  "allOf": [
    {"if": {"required": ["audio_time_s"], "properties": {"audio_time_s": {"type": "null"}}},
     "then": {"description": "Rule: a null audio_time_s needs audio_time_reason.", "required": ["audio_time_reason"]}},
    {"if": {"required": ["audio_time_s"], "properties": {"audio_time_s": {"type": "number"}}},
     "then": {"properties": {"audio_time_reason": {"description": "Rule: audio_time_reason is only for a null audio_time_s.", "not": {}}}}},
    {"if": {"required": ["event_type"], "properties": {"event_type": {"const": "run_started"}}}, "then": {"$ref": "#/$defs/type_run_started"}},
    {"if": {"required": ["event_type"], "properties": {"event_type": {"const": "run_finished"}}}, "then": {"$ref": "#/$defs/type_run_finished"}},
    {"if": {"required": ["event_type"], "properties": {"event_type": {"const": "clip_started"}}}, "then": {"$ref": "#/$defs/type_clip_started"}},
    {"if": {"required": ["event_type"], "properties": {"event_type": {"const": "clip_finished"}}}, "then": {"$ref": "#/$defs/type_clip_finished"}},
    {"if": {"required": ["event_type"], "properties": {"event_type": {"const": "speech_start"}}}, "then": {"$ref": "#/$defs/type_speech_start"}},
    {"if": {"required": ["event_type"], "properties": {"event_type": {"const": "speech_end"}}}, "then": {"$ref": "#/$defs/type_speech_end"}},
    {"if": {"required": ["event_type"], "properties": {"event_type": {"const": "partial"}}}, "then": {"$ref": "#/$defs/type_partial"}},
    {"if": {"required": ["event_type"], "properties": {"event_type": {"const": "final"}}}, "then": {"$ref": "#/$defs/type_final"}},
    {"if": {"required": ["event_type"], "properties": {"event_type": {"const": "timing_mark"}}}, "then": {"$ref": "#/$defs/type_timing_mark"}},
    {"if": {"required": ["event_type"], "properties": {"event_type": {"const": "error"}}}, "then": {"$ref": "#/$defs/type_error"}}
  ],
  "$defs": {
    "utc": {"type": "string", "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$(?!\\n)"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$(?!\\n)"},
    "run_level": {"properties": {"clip_id": {"description": "Rule: run_started and run_finished are run-level events; clip_id must be null.", "type": "null"}}},
    "clip_level": {"properties": {"clip_id": {"description": "Rule: this event type belongs to a clip; clip_id must name it.", "type": "string"}}},
    "type_run_started": {"allOf": [{"$ref": "#/$defs/run_level"}], "properties": {"payload": {"$ref": "#/$defs/payload_empty"}}},
    "type_run_finished": {"allOf": [{"$ref": "#/$defs/run_level"}], "properties": {"payload": {"$ref": "#/$defs/payload_run_finished"}}},
    "type_clip_started": {"allOf": [{"$ref": "#/$defs/clip_level"}], "properties": {"payload": {"$ref": "#/$defs/payload_empty"}}},
    "type_clip_finished": {"allOf": [{"$ref": "#/$defs/clip_level"}], "properties": {"payload": {"$ref": "#/$defs/payload_empty"}}},
    "type_speech_start": {"allOf": [{"$ref": "#/$defs/clip_level"}], "properties": {"payload": {"$ref": "#/$defs/payload_empty"}}},
    "type_speech_end": {"allOf": [{"$ref": "#/$defs/clip_level"}], "properties": {"payload": {"$ref": "#/$defs/payload_empty"}}},
    "type_partial": {"allOf": [{"$ref": "#/$defs/clip_level"}], "properties": {"payload": {"$ref": "#/$defs/payload_partial"}}},
    "type_final": {"allOf": [{"$ref": "#/$defs/clip_level"}], "properties": {"payload": {"$ref": "#/$defs/payload_final"}}},
    "type_timing_mark": {"description": "Run-level when clip_id is null, clip-level otherwise.", "properties": {"payload": {"$ref": "#/$defs/payload_timing_mark"}}},
    "type_error": {"description": "Run-level when clip_id is null, clip-level otherwise.", "properties": {"payload": {"$ref": "#/$defs/payload_error"}}},
    "payload_empty": {"description": "No fields: the envelope carries everything.", "type": "object", "additionalProperties": false},
    "payload_run_finished": {"type": "object", "required": ["status"], "additionalProperties": false,
                             "properties": {"status": {"description": "How the run ended.", "enum": ["completed", "failed"]}}},
    "payload_partial": {"type": "object", "required": ["text"], "additionalProperties": false,
                        "properties": {"text": {"description": "Interim transcript text.", "type": "string"}}},
    "payload_final": {"type": "object", "required": ["text"], "additionalProperties": false,
                      "properties": {"text": {"description": "Final transcript text.", "type": "string"},
                                     "words": {"description": "Optional word timings, in order.", "type": "array", "items": {"$ref": "#/$defs/word"}}}},
    "word": {"type": "object", "required": ["word", "start_s", "end_s"], "additionalProperties": false,
             "properties": {"word": {"description": "The word as recognised.", "type": "string", "minLength": 1},
                            "start_s": {"description": "Word start in the clip's audio, seconds.", "type": "number", "minimum": 0},
                            "end_s": {"description": "Word end in the clip's audio, seconds; not before start_s.", "type": "number", "minimum": 0}}},
    "payload_timing_mark": {"type": "object", "required": ["mark"], "additionalProperties": false,
                            "properties": {"mark": {"description": "What is marked, such as first-partial.", "$ref": "#/$defs/id"}}},
    "payload_error": {"type": "object", "required": ["code", "message", "run_continues"], "additionalProperties": false,
                      "properties": {"code": {"description": "Stable machine-readable error code.", "type": "string", "minLength": 1},
                                     "message": {"description": "Human-readable explanation.", "type": "string", "minLength": 1},
                                     "run_continues": {"description": "True when the run goes on after this error.", "type": "boolean"}}}
  }
}
