{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aqis-lab:contracts:run_card:1.0",
  "title": "AQIS lab run card, version 1.0",
  "description": "Everything that decides a run's result. Contract document: docs/contracts/RUN_CARD.md. run_card_id is the SHA-256 of the canonical card without run_card_id, created_utc and notes (checked by the validator). Patterns end in $(?!\\n) so that they mean 'end of text' in both ECMA-262 and Python.",
  "type": "object",
  "required": ["schema_version", "run_card_id", "pack", "model", "processing", "mode", "machine", "seed", "normaliser",
               "lock", "git", "created_utc", "notes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"description": "Contract version, '<major>.<minor>'.", "enum": ["1.0"]},
    "run_card_id": {"description": "SHA-256 of the canonical card without run_card_id, created_utc and notes.", "$ref": "#/$defs/sha256"},
    "pack": {"description": "Pack manifest the run reads; null only when mode is human_session.", "type": ["object", "null"],
             "required": ["manifest_id", "version", "sha256"], "additionalProperties": false,
             "properties": {"manifest_id": {"description": "manifest_id of the pack manifest.", "$ref": "#/$defs/id"},
                            "version": {"description": "version of the pack manifest (semantic version).", "$ref": "#/$defs/semver"},
                            "sha256": {"description": "SHA-256 of the manifest's canonical JSON.", "$ref": "#/$defs/sha256"}}},
    "model": {"description": "The model under test.", "type": "object",
              "required": ["family", "name", "version", "checksum", "settings"], "additionalProperties": false,
              "properties": {"family": {"description": "Model family, such as vosk.", "$ref": "#/$defs/text"},
                             "name": {"description": "Model name.", "$ref": "#/$defs/text"},
                             "version": {"description": "Model version, or null when only a checksum identifies it.", "type": ["string", "null"], "minLength": 1},
                             "checksum": {"description": "SHA-256 of the model files, or null when the version identifies it.", "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$(?!\\n)"},
                             "settings": {"description": "Model settings; any members.", "type": "object"}},
              "if": {"description": "Both version and checksum are null.", "required": ["version", "checksum"],
                     "properties": {"version": {"type": "null"}, "checksum": {"type": "null"}}},
              "then": {"description": "At least one of version and checksum must identify the model.",
                       "properties": {"version": {"not": {"type": "null"}}, "checksum": {"not": {"type": "null"}}}}},
    "processing": {"description": "Ordered fix steps applied before each path's component.", "type": "object",
                   "required": ["vad", "stt", "emotion"], "additionalProperties": false,
                   "properties": {"vad": {"description": "Steps before voice activity detection, in order.", "$ref": "#/$defs/steps"},
                                  "stt": {"description": "Steps before speech-to-text, in order.", "$ref": "#/$defs/steps"},
                                  "emotion": {"description": "Steps before emotion recognition, in order.", "$ref": "#/$defs/steps"}}},
    "mode": {"description": "How the run is executed.",
             "enum": ["batch", "realspeed_cpu", "gpu_compute_delay", "tier2_live", "nearlive_replay", "human_session"]},
    "machine": {"description": "Where the run executes (filled by aqis_lab.platform).", "type": "object",
                "required": ["platform", "gpu", "cpu_model", "architecture", "os", "python_version"], "additionalProperties": false,
                "properties": {"platform": {"description": "Lab platform.", "enum": ["cloud-vm", "colab", "kaggle", "oracle"]},
                               "gpu": {"description": "GPU type, or null without a GPU.", "type": ["string", "null"], "minLength": 1},
                               "cpu_model": {"description": "CPU model name.", "$ref": "#/$defs/text"},
                               "architecture": {"description": "Machine architecture, such as x86_64 or aarch64.", "$ref": "#/$defs/text"},
                               "os": {"description": "Operating system name and version.", "$ref": "#/$defs/text"},
                               "python_version": {"description": "Python version X.Y.Z, optionally with a suffix.", "type": "string",
                                                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[0-9A-Za-z.+-]*$(?!\\n)"}}},
    "seed": {"description": "Seed for every random step of the run.", "type": "integer", "minimum": 0},
    "normaliser": {"description": "Text normaliser used for scoring; null for runs that produce no text.", "type": ["object", "null"],
                   "required": ["name", "version"], "additionalProperties": false,
                   "properties": {"name": {"description": "Normaliser name.", "$ref": "#/$defs/text"},
                                  "version": {"description": "Normaliser version.", "$ref": "#/$defs/text"}}},
    "lock": {"description": "Dependency lock the run's environment was installed from.", "type": "object",
             "required": ["file", "sha256"], "additionalProperties": false,
             "properties": {"file": {"description": "Repository-relative POSIX path of the lock file.", "$ref": "#/$defs/relative_path"},
                            "sha256": {"description": "SHA-256 of the lock file's bytes.", "$ref": "#/$defs/sha256"}}},
    "git": {"description": "Code the run used.", "type": "object", "required": ["commit", "dirty"], "additionalProperties": false,
            "properties": {"commit": {"description": "Full commit hash.", "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$(?!\\n)"},
                           "dirty": {"description": "True when the checkout had uncommitted changes.", "type": "boolean"}}},
    "created_utc": {"description": "When the card was written, UTC ISO 8601 with Z.", "$ref": "#/$defs/utc"},
    "notes": {"description": "Free text; not part of run_card_id.", "type": "string"}
  },
  "allOf": [
    {"if": {"required": ["mode"], "properties": {"mode": {"const": "human_session"}}},
     "else": {"properties": {"pack": {"type": "object"}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$(?!\\n)"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?!\\n)"},
    "utc": {"type": "string", "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$(?!\\n)"},
    "semver": {"type": "string",
               "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$(?!\\n)"},
    "relative_path": {"description": "Relative POSIX path: no leading '/', no '.', '..' or empty segment, no backslash or control character.",
                      "type": "string", "pattern": "^(?!(.*/)?\\.{1,2}(/|$))[^/\\\\\\x00-\\x1f]+(/[^/\\\\\\x00-\\x1f]+)*$(?!\\n)"},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "step": {"type": "object", "required": ["name", "params"], "additionalProperties": false,
             "properties": {"name": {"description": "Fix step name.", "$ref": "#/$defs/text"},
                            "params": {"description": "Step parameters; any members.", "type": "object"}}}
  }
}
